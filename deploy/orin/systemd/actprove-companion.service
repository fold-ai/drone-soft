[Unit]
Description=ActProve Orin companion (Lock/Takeover → ArduPilot GUIDED)
After=local-fs.target
Wants=actprove-vision.service

[Service]
Type=simple
User=actprove
Group=dialout
SupplementaryGroups=dialout
RuntimeDirectory=actprove
RuntimeDirectoryMode=0750
WorkingDirectory=/opt/drone-soft
ExecStart=/opt/drone-soft/onboard/build/actprove_companion --port /dev/ttyTHS1 --baud 57600 --ipc /run/actprove/detections.sock --lock-ch 7 --takeover-ch 8 --speed 18 --hfov 10 --known-width 0.35
Restart=on-failure
RestartSec=1
TimeoutStopSec=8

# Companion is allowed UART to the flight controller. Cameras stay in actprove-vision.
DevicePolicy=closed
DeviceAllow=/dev/ttyTHS0 rw
DeviceAllow=/dev/ttyTHS1 rw
DeviceAllow=/dev/ttyTHS2 rw
DeviceAllow=/dev/ttyUSB0 rw
DeviceAllow=/dev/ttyUSB1 rw
DeviceAllow=/dev/ttyACM0 rw
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
