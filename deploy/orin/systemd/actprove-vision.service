[Unit]
Description=ActProve single-camera sky detect (balloon + UAV) to companion
After=actprove-companion.service
Requires=actprove-companion.service

[Service]
Type=simple
User=actprove
Group=video
SupplementaryGroups=plugdev
WorkingDirectory=/opt/drone-soft
ExecStart=/usr/bin/python3 /opt/drone-soft/tools/first_test_hdmi_preview.py --headless --target sky --hfov 10 --ipc /run/actprove/detections.sock
Restart=on-failure
RestartSec=2

# One JAI USB3 Vision camera. HDMI preview is started by hand, not this unit.
DevicePolicy=closed
DeviceAllow=/dev/bus/usb rw
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
